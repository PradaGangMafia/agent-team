# =============================================================================
# Agent-Team configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values:
#
#     cp example.env .env
#
# Real environment variables always override values in .env.
# Anything left blank falls back to the defaults documented in agent_team.py.
# =============================================================================

# -----------------------------------------------------------------------------
# MANAGER AGENT — plans, dispatches and verifies. A fast/cheap model is fine.
# Any OpenAI-compatible endpoint works (OpenAI, Azure-style proxies, OpenRouter,
# LiteLLM, vLLM, Ollama with /v1, LocalAI, llama.cpp server, ...).
# -----------------------------------------------------------------------------
MANAGER_BASE_URL=https://api.openai.com/v1
MANAGER_API_KEY=sk-your-manager-key
MANAGER_MODEL=gpt-4o-mini
MANAGER_TEMPERATURE=0.2
MANAGER_MAX_TOKENS=4096
# Seconds to wait for a single response.
MANAGER_TIMEOUT=300
# Name of the max-token field. OpenAI o1/o3-style models need
# "max_completion_tokens"; most other servers use "max_tokens".
MANAGER_TOKENS_PARAM=max_tokens
# Optional JSON object merged into every request body (e.g. {"top_p": 0.9}).
MANAGER_EXTRA_JSON=

# -----------------------------------------------------------------------------
# WORKER AGENT — executes tasks with tools. Use a strong, tool-capable,
# vision-capable model (it needs to read reference images).
# -----------------------------------------------------------------------------
WORKER_BASE_URL=https://api.openai.com/v1
WORKER_API_KEY=sk-your-worker-key
WORKER_MODEL=gpt-4o
WORKER_TEMPERATURE=0.4
WORKER_MAX_TOKENS=8192
WORKER_TIMEOUT=600
WORKER_TOKENS_PARAM=max_tokens
WORKER_EXTRA_JSON=

# -----------------------------------------------------------------------------
# IMAGE GENERATION (worker tool: generate_image)
# -----------------------------------------------------------------------------
# IMAGE_MODE:
#   auto   (default) use /v1/images/* and fall back to /v1/chat/completions
#   images          only /v1/images/generations + /v1/images/edits
#   chat            only multimodal /v1/chat/completions (OpenRouter, Gemini, ...)
IMAGE_MODE=auto

# Model used for /v1/images/* — e.g. gpt-image-1, dall-e-3, flux, sdxl, ...
# Leave blank if you only use IMAGE_MODE=chat.
IMAGE_MODEL=gpt-image-1

# Endpoint + key for images. Blank = reuse WORKER_BASE_URL / WORKER_API_KEY.
IMAGE_BASE_URL=
IMAGE_API_KEY=

# Defaults passed to the image endpoint (blank = server default).
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=
# Multipart field name for reference images on /v1/images/edits.
# "image" for OpenAI/gpt-image-1, some servers want "image[]".
IMAGE_EDIT_FIELD=image
# Response format for the images API: "b64_json", "url", or blank for default.
IMAGE_RESPONSE_FORMAT=
IMAGE_TIMEOUT=600
# Allow the automatic fallback to multimodal chat when the images API refuses.
IMAGE_CHAT_FALLBACK=true
# Model to use for the chat fallback (blank = WORKER_MODEL).
IMAGE_CHAT_MODEL=

# -----------------------------------------------------------------------------
# WORKFLOW BEHAVIOUR
# -----------------------------------------------------------------------------
# Attempts per task before the workflow gives up on it.
MAX_TASK_ATTEMPTS=2
# Tool-call rounds allowed for the manager / worker per attempt.
MANAGER_MAX_ROUNDS=20
WORKER_MAX_ROUNDS=40
# A log smaller than this (bytes) counts as missing evidence.
MIN_LOG_BYTES=120
# Require new/changed files in work/ before a task can pass.
REQUIRE_WORK_OUTPUT=true
# Keep going after a failed task instead of halting the queue.
CONTINUE_ON_FAILURE=false
# Let the worker run shell commands and Python (recommended for coding tasks).
ALLOW_SHELL=true
SHELL_TIMEOUT=300
# Tool output is truncated to this many characters before it reaches the model.
TOOL_RESULT_MAX_CHARS=24000
# Largest image attached to the conversation for vision (bytes).
MAX_IMAGE_BYTES=8388608

# -----------------------------------------------------------------------------
# FOLDERS AND PROMPTS (relative to the project root unless absolute)
# -----------------------------------------------------------------------------
TASKS_DIR=tasks
REF_DIR=ref
LOGS_DIR=logs
WORK_DIR=work
MANAGER_PROMPT=manager.md
WORKER_PROMPT=worker.md

# Set to true for a full offline dry run (no network calls, mock worker output).
AGENT_TEAM_SIMULATE=false
